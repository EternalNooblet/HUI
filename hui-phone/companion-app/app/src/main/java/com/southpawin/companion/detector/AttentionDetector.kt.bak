package com.southpawin.companion.detector

import android.content.Context
import android.graphics.ImageFormat
import android.media.AudioFormat
import android.media.AudioRecord
import android.media.MediaRecorder
import android.util.Log
import android.util.Size
import androidx.camera.core.CameraSelector
import androidx.camera.core.ImageAnalysis
import androidx.camera.core.ImageProxy
import androidx.camera.lifecycle.ProcessCameraProvider
import androidx.camera.view.PreviewView
import com.google.common.util.concurrent.ListenableFuture
import com.southpawin.companion.Config
import com.southpawin.companion.event.AttentionEvent
import com.southpawin.companion.event.EventBus
import com.southpawin.companion.util.YuvToRgbConverter
import org.tensorflow.lite.Interpreter
import org.tensorflow.lite.support.image.TensorImage
import org.tensorflow.lite.support.tensorbuffer.TensorBuffer
import timber.log.Timber
import java.io.FileInputStream
import java.nio.ByteBuffer
import java.nio.ByteOrder
import java.util.concurrent.Executors

class AttentionDetector(
    private val context: Context,
    private val eventBus: EventBus
) {
    private val cameraExecutor = Executors.newSingleThreadExecutor()
    private val audioExecutor = Executors.newSingleThreadExecutor()
    private var interpreter: Interpreter? = null
    private var cameraProvider: ListenableFuture<ProcessCameraProvider>? = null
    private var audioRecord: AudioRecord? = null
    private var isRunning = false
    private var frameCount = 0L
    
    // Model input/output specs (adjust based on your TF Lite model)
    private val INPUT_IMAGE_SIZE = 224
    private val INPUT_AUDIO_SAMPLES = 1600  // 100ms @ 16kHz
    private val OUTPUT_CLASSES = 3  // [addressing, looking, speaking]
    
    init {
        loadModel()
    }
    
    private fun loadModel() {
        try {
            // Load model from assets or files dir
            val modelFile = context.getFileStreamPath("gaze_detector.tflite")
            if (!modelFile.exists()) {
                // Copy from assets
                context.assets.open("gaze_detector.tflite").use { input ->
                    modelFile.outputStream().use { output ->
                        input.copyTo(output)
                    }
                }
            }
            
            val options = Interpreter.Options().apply {
                setNumThreads(2)
                // setUseNNAPI(true) // Optional: use NNAPI if available
            }
            interpreter = Interpreter(FileInputStream(modelFile).channel, options)
            Timber.i("TF Lite model loaded: ${modelFile.absolutePath}")
        } catch (e: Exception) {
            Timber.e(e, "Failed to load TF Lite model")
        }
    }
    
    fun start() {
        if (isRunning) return
        isRunning = true
        
        startCamera()
        startAudio()
        
        cameraExecutor.execute { detectionLoop() }
    }
    
    fun stop() {
        isRunning = false
        cameraProvider?.cancel(true)
        audioRecord?.stop()
        audioRecord?.release()
        audioRecord = null
        cameraExecutor.shutdown()
        audioExecutor.shutdown()
    }
    
    private fun startCamera() {
        cameraProvider = ProcessCameraProvider.getInstance(context)
        cameraProvider?.addListener({
            try {
                val provider = cameraProvider?.get()
                val imageAnalysis = ImageAnalysis.Builder()
                    .setTargetResolution(Size(INPUT_IMAGE_SIZE, INPUT_IMAGE_SIZE))
                    .setBackpressureStrategy(ImageAnalysis.STRATEGY_KEEP_ONLY_LATEST)
                    .setOutputImageFormat(ImageFormat.YUV_420_888)
                    .build()
                
                imageAnalysis.setAnalyzer(cameraExecutor, { imageProxy ->
                    processFrame(imageProxy)
                })
                
                val cameraSelector = CameraSelector.Builder()
                    .requireLensFacing(CameraSelector.LENS_FACING_FRONT)
                    .build()
                
                provider?.bindToLifecycle(
                    /* lifecycleOwner */ null, // Will bind manually
                    cameraSelector,
                    imageAnalysis
                )
            } catch (e: Exception) {
                Timber.e(e, "Camera bind failed")
            }
        }, cameraExecutor)
    }
    
    private fun startAudio() {
        val bufferSize = AudioRecord.getMinBufferSize(
            16000, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT
        )
        audioRecord = AudioRecord(
            MediaRecorder.AudioSource.VOICE_COMMUNICATION,
            16000, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT,
            bufferSize.coerceAtLeast(INPUT_AUDIO_SAMPLES * 2)
        ).also { it.startRecording() }
    }
    
    private fun detectionLoop() {
        while (isRunning) {
            Thread.sleep(Config.gazeCheckIntervalMs)
            // Frame processing happens in camera analyzer callback
            // Audio is read on-demand in processFrame
        }
    }
    
    private fun processFrame(imageProxy: ImageProxy) {
        val startTime = System.currentTimeMillis()
        
        try {
            // Convert YUV to RGB for model
            val rgbBuffer = YuvToRgbConverter.yuv420ToRgb(imageProxy, INPUT_IMAGE_SIZE, INPUT_IMAGE_SIZE)
            
            // Read audio chunk
            val audioBuffer = readAudioChunk()
            
            // Run inference
            val result = runInference(rgbBuffer, audioBuffer)
            
            if (result.addressing && result.confidence >= Config.gazeConfidenceThreshold) {
                val event = AttentionEvent(
                    AttentionEvent.AttentionPayload(
                        addressing = true,
                        looking = result.looking,
                        speaking = result.speaking,
                        confidence = result.confidence,
                        gazeVector = result.gazeVector,
                        audioLevelDb = result.audioLevelDb
                    )
                )
                eventBus.tryPost(event)
                Timber.d("Attention detected: confidence=%.2f", result.confidence)
            }
            
            frameCount++
            
        } catch (e: Exception) {
            Timber.e(e, "Frame processing error")
        } finally {
            imageProxy.close()
        }
    }
    
    private fun readAudioChunk(): FloatArray {
        val buffer = ShortArray(INPUT_AUDIO_SAMPLES)
        val read = audioRecord?.read(buffer, 0, INPUT_AUDIO_SAMPLES) ?: 0
        return buffer.take(read).map { it.toFloat() / 32768.0f }.toFloatArray()
    }
    
    private data class InferenceResult(
        val addressing: Boolean,
        val looking: Boolean,
        val speaking: Boolean,
        val confidence: Float,
        val gazeVector: FloatArray? = null,
        val audioLevelDb: Float? = null
    )
    
    private fun runInference(imageBuffer: ByteBuffer, audioBuffer: FloatArray): InferenceResult {
        interpreter?.let { interpreter ->
            // Prepare inputs
            val imageInput = TensorImage.fromByteBuffer(imageBuffer)
            val audioInput = TensorBuffer.createFixedSize(intArrayOf(1, INPUT_AUDIO_SAMPLES), org.tensorflow.lite.DataType.FLOAT32)
            audioInput.loadArray(audioBuffer)
            
            // Run inference
            val outputBuffer = TensorBuffer.createFixedSize(intArrayOf(1, OUTPUT_CLASSES), org.tensorflow.lite.DataType.FLOAT32)
            val inputs = arrayOf<Any>(imageInput.buffer, audioInput.buffer)
            val outputs = mapOf(0 to outputBuffer.buffer)
            interpreter.runForMultipleInputsOutputs(inputs, outputs)
            
            // Parse outputs
            val probs = outputBuffer.floatArray
            val addressing = probs[0] > Config.gazeConfidenceThreshold
            val looking = probs[1] > 0.5f
            val speaking = probs[2] > 0.5f
            val confidence = probs[0]
            
            // Calculate audio level in dB
            val audioLevelDb = 20 * Math.log10(audioBuffer.map { it * it }.average().sqrt() + 1e-10).toFloat()
            
            return InferenceResult(addressing, looking, speaking, confidence, null, audioLevelDb)
        }
        
        // Fallback if no model
        return InferenceResult(false, false, false, 0f)
    }
    
    companion object {
        // Simple placeholder - in reality you'd have a proper TF Lite model
        // This allows the app to build and run without a real model
        fun createPlaceholderModel(context: Context) {
            // Generates a dummy model file for testing
            // In production, replace with actual trained model
        }
    }
}

// Utility for YUV to RGB conversion
object YuvToRgbConverter {
    fun yuv420ToRgb(image: ImageProxy, targetWidth: Int, targetHeight: Int): ByteBuffer {
        val yBuffer = image.planes[0].buffer
        val uBuffer = image.planes[1].buffer
        val vBuffer = image.planes[2].buffer
        
        val yRowStride = image.planes[0].rowStride
        val uvRowStride = image.planes[1].rowStride
        val uvPixelStride = image.planes[1].pixelStride
        
        val output = ByteBuffer.allocateDirect(targetWidth * targetHeight * 3).order(ByteOrder.nativeOrder())
        
        // Simple downscale + YUV to RGB conversion
        // For production, use RenderScript or GPU shader
        val scaleX = image.width.toFloat() / targetWidth
        val scaleY = image.height.toFloat() / targetHeight
        
        for (y in 0 until targetHeight) {
            for (x in 0 until targetWidth) {
                val srcX = (x * scaleX).toInt().coerceAtMost(image.width - 1)
                val srcY = (y * scaleY).toInt().coerceAtMost(image.height - 1)
                
                val yVal = (yBuffer[srcY * yRowStride + srcX].toInt() + 256) % 256
                val uVal = (uBuffer[(srcY / 2) * uvRowStride + (srcX / 2) * uvPixelStride].toInt() + 256) % 256
                val vVal = (vBuffer[(srcY / 2) * uvRowStride + (srcX / 2) * uvPixelStride].toInt() + 256) % 256
                
                // YUV to RGB
                var r = (yVal + 1.402 * (vVal - 128)).toInt().coerceIn(0, 255)
                var g = (yVal - 0.344 * (uVal - 128) - 0.714 * (vVal - 128)).toInt().coerceIn(0, 255)
                var b = (yVal + 1.772 * (uVal - 128)).toInt().coerceIn(0, 255)
                
                output.put(r.toByte()).put(g.toByte()).put(b.toByte())
            }
        }
        output.rewind()
        return output
    }
}