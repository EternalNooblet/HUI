package com.hui.companion.transport

import android.content.Context
import android.net.nsd.NsdManager
import android.net.nsd.NsdServiceInfo
import android.util.Log
import com.hui.companion.Config
import com.hui.companion.event.Command
import com.hui.companion.event.Event
import com.hui.companion.event.EventBus
import com.hui.companion.util.BackoffStrategy
import okhttp3.*
import okio.ByteString
import timber.log.Timber
import java.net.InetAddress
import java.util.concurrent.TimeUnit
import javax.net.ssl.SSLContext
import javax.net.ssl.X509TrustManager

class Transport(
    private val context: Context,
    private val eventBus: EventBus,
    private val commandExecutor: CommandExecutor
) {
    private var webSocket: WebSocket? = null
    private val client = buildClient()
    private val backoff = BackoffStrategy(initialDelayMs = 1000, maxDelayMs = 30000, multiplier = 2.0)
    private var isConnecting = false
    private val nsdManager = context.getSystemService(Context.NSD_SERVICE) as NsdManager
    private var discoveryListener: NsdManager.DiscoveryListener? = null
    
    private val listener = object : WebSocketListener() {
        override fun onOpen(webSocket: WebSocket, response: Response) {
            Timber.i("WebSocket connected")
            backoff.reset()
            isConnecting = false
            // Send hello/identify
            sendHello()
        }
        
        override fun onMessage(webSocket: WebSocket, text: String) {
            try {
                val command = Command.parse(text)
                eventBus.tryPostCommand(command)
            } catch (e: Exception) {
                Timber.e(e, "Failed to parse command")
            }
        }
        
        override fun onMessage(webSocket: WebSocket, bytes: ByteString) {
            // Binary messages not used currently
        }
        
        override fun onClosing(webSocket: WebSocket, code: Int, reason: String) {
            Timber.w("WebSocket closing: $code $reason")
            webSocket.close(1000, null)
        }
        
        override fun onClosed(webSocket: WebSocket, code: Int, reason: String) {
            Timber.w("WebSocket closed: $code $reason")
            this@Transport.webSocket = null
            if (isConnecting.not()) scheduleReconnect()
        }
        
        override fun onFailure(webSocket: WebSocket, t: Throwable, response: Response?) {
            Timber.e(t, "WebSocket failure")
            this@Transport.webSocket = null
            if (isConnecting.not()) scheduleReconnect()
        }
    }
    
    fun connect() {
        if (isConnecting || webSocket != null) return
        
        // Try mDNS discovery first
        startDiscovery()
        
        // Fallback to configured URL after short delay
        android.os.Handler(android.os.Looper.getMainLooper()).postDelayed({
            if (webSocket == null && !isConnecting) {
                connectToUrl(Config.wsUrl)
            }
        }, 3000)
    }
    
    private fun startDiscovery() {
        discoveryListener = object : NsdManager.DiscoveryListener {
            override fun onDiscoveryStarted(serviceType: String) {
                Timber.d("mDNS discovery started")
            }
            
            override fun onServiceFound(serviceInfo: NsdServiceInfo) {
                if (serviceInfo.serviceType == "_companion._tcp") {
                    nsdManager.resolveService(serviceInfo, resolveListener)
                }
            }
            
            override fun onServiceLost(serviceInfo: NsdServiceInfo) {}
            override fun onDiscoveryStopped(serviceType: String) {}
            override fun onStartDiscoveryFailed(serviceType: String, errorCode: Int) {}
            override fun onStopDiscoveryFailed(serviceType: String, errorCode: Int) {}
        }
        
        nsdManager.discoverServices("_companion._tcp", NsdManager.PROTOCOL_DNS_SD, discoveryListener!!)
    }
    
    private val resolveListener = object : NsdManager.ResolveListener {
        override fun onResolveFailed(serviceInfo: NsdServiceInfo, errorCode: Int) {}
        
        override fun onServiceResolved(serviceInfo: NsdServiceInfo) {
            val host = serviceInfo.host ?: return
            val port = serviceInfo.port
            val url = "ws://$host:$port/ws"
            Timber.i("Discovered server via mDNS: $url")
            connectToUrl(url)
            stopDiscovery()
        }
    }
    
    private fun stopDiscovery() {
        discoveryListener?.let { nsdManager.stopServiceDiscovery(it) }
        discoveryListener = null
    }
    
    private fun connectToUrl(url: String) {
        if (url.isBlank()) return
        isConnecting = true
        Timber.i("Connecting to $url")
        
        val request = Request.Builder()
            .url(url)
            .addHeader("Authorization", "Bearer ${Config.authToken ?: ""}")
            .addHeader("X-Device-ID", Config.deviceId)
            .build()
        
        client.newWebSocket(request, listener)
    }
    
    private fun sendHello() {
        val hello = """{"type":"hello","device_id":"${Config.deviceId}","capabilities":["attention","battery","notification","screen","audio"]}"""
        webSocket?.send(hello)
    }
    
    fun send(event: Event) {
        webSocket?.send(event.toJson()) ?: queueForHttpFallback(event)
    }
    
    private fun queueForHttpFallback(event: Event) {
        // TODO: Implement local queue with Room for HTTP fallback
        Timber.w("WebSocket not connected, event queued for HTTP fallback: ${event.type}")
    }
    
    private fun scheduleReconnect() {
        val delay = backoff.nextDelay()
        Timber.i("Scheduling reconnect in ${delay}ms")
        android.os.Handler(android.os.Looper.getMainLooper()).postDelayed({ connect() }, delay)
    }
    
    fun disconnect() {
        stopDiscovery()
        webSocket?.close(1000, "Client disconnect")
        webSocket = null
    }
    
    private fun buildClient(): OkHttpClient {
        // Trust all certs for development (self-signed)
        val trustAllCerts = arrayOf<X509TrustManager>(object : X509TrustManager {
            override fun checkClientTrusted(chain: Array<java.security.cert.X509Certificate>?, authType: String?) {}
            override fun checkServerTrusted(chain: Array<java.security.cert.X509Certificate>?, authType: String?) {}
            override fun getAcceptedIssuers(): Array<java.security.cert.X509Certificate> = emptyArray()
        })
        
        val sslContext = SSLContext.getInstance("TLS").apply {
            init(null, trustAllCerts, java.security.SecureRandom())
        }
        
        return OkHttpClient.Builder()
            .sslSocketFactory(sslContext.socketFactory, trustAllCerts[0])
            .hostnameVerifier { _, _ -> true }
            .pingInterval(15, TimeUnit.SECONDS)
            .build()
    }
}

// Simple command executor for server commands
class CommandExecutor(private val context: Context) {
    fun execute(command: Command): EventModels.Result {
        return when (command.command) {
            "speak" -> executeSpeak(command.payload)
            "screen_action" -> executeScreenAction(command.payload)
            "launch_app" -> executeLaunchApp(command.payload)
            "media" -> executeMedia(command.payload)
            "config" -> { Config.updateFromCommand(command.payload); EventModels.Result.Success() }
            else -> EventModels.Result.UnknownCommand
        }
    }
    
    private fun executeSpeak(payload: CommandPayload): EventModels.Result {
        payload.text?.let { text ->
            android.speech.tts.TextToSpeech(context, { status ->
                if (status == android.speech.tts.TextToSpeech.SUCCESS) {
                    it.speak(text, android.speech.tts.TextToSpeech.QUEUE_FLUSH, null, "companion_tts")
                }
            })
        }
        return EventModels.Result.Success()
    }
    
    private fun executeScreenAction(payload: CommandPayload): EventModels.Result {
        payload.action?.let { action ->
            val pm = context.getSystemService(Context.POWER_SERVICE) as android.os.PowerManager
            when (action) {
                "wake" -> {
                    val wakeLock = pm.newWakeLock(
                        android.os.PowerManager.SCREEN_BRIGHT_WAKE_LOCK or 
                        android.os.PowerManager.ACQUIRE_CAUSES_WAKEUP, "companion:wake"
                    )
                    wakeLock.acquire(5000)
                }
                "sleep" -> pm.goToSleep(System.currentTimeMillis())
                "unlock" -> {
                    // Requires device admin or accessibility service - not implemented
                }
            }
        }
        return EventModels.Result.Success()
    }
    
    private fun executeLaunchApp(payload: CommandPayload): EventModels.Result {
        payload.packageName?.let { pkg ->
            context.packageManager.getLaunchIntentForPackage(pkg)?.also { intent ->
                intent.addFlags(android.content.Intent.FLAG_ACTIVITY_NEW_TASK)
                context.startActivity(intent)
            }
        }
        return EventModels.Result.Success()
    }
    
    private fun executeMedia(payload: CommandPayload): EventModels.Result {
        payload.action?.let { action ->
            val intent = Intent(android.content.Intent.ACTION_MEDIA_BUTTON).apply {
                putExtra(android.content.Intent.EXTRA_KEY_EVENT, 
                    android.view.KeyEvent(android.view.KeyEvent.ACTION_DOWN, when(action) {
                        "play_pause" -> android.view.KeyEvent.KEYCODE_MEDIA_PLAY_PAUSE
                        "next" -> android.view.KeyEvent.KEYCODE_MEDIA_NEXT
                        "prev" -> android.view.KeyEvent.KEYCODE_MEDIA_PREVIOUS
                        "stop" -> android.view.KeyEvent.KEYCODE_MEDIA_STOP
                        else -> return@let
                    })
                )
            }
            context.sendOrderedBroadcast(intent, null)
        }
        return EventModels.Result.Success()
    }
}

// Backoff strategy for reconnection
class BackoffStrategy(
    private val initialDelayMs: Long,
    private val maxDelayMs: Long,
    private val multiplier: Double
) {
    private var currentDelay = initialDelayMs
    
    fun nextDelay(): Long {
        val delay = currentDelay
        currentDelay = (currentDelay * multiplier).toLong().coerceAtMost(maxDelayMs)
        return delay
    }
    
    fun reset() {
        currentDelay = initialDelayMs
    }
}