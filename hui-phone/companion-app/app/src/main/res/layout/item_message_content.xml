<?xml version="1.0" encoding="utf-8"?>
<!-- MessageContent: rounded-lg p-2 text-foreground bg-secondary prose break-words whitespace-normal -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/messageContentContainer"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:background="@drawable/bg_message_content"
    android:padding="@dimen/pk_space_2">

    <!-- Markdown-rendered content goes here (added programmatically) -->
    <LinearLayout
        android:id="@+id/messageContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- Citations row (Source chips) -->
    <LinearLayout
        android:id="@+id/messageCitations"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginTop="@dimen/pk_space_1" />

    <!-- Tool call (included when role=tool) -->
    <include
        android:id="@+id/messageToolCall"
        layout="@layout/item_tool_call"
        android:visibility="gone" />

    <!-- Reasoning (ChainOfThought) -->
    <include
        android:id="@+id/messageReasoning"
        layout="@layout/item_reasoning_step"
        android:visibility="gone" />
</LinearLayout>