<?xml version="1.0" encoding="utf-8"?>
<!-- PromptInputActions: flex items-center gap-2 -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <!-- Attachment action: paperclip icon with tooltip -->
    <ImageButton
        android:id="@+id/promptInputAttachmentBtn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="@dimen/pk_space_2"
        android:src="@drawable/ic_attachment"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/prompt_input_attachment_tooltip"
        android:scaleType="centerInside"
        android:padding="@dimen/pk_space_2" />

    <!-- Voice action: microphone icon with tooltip -->
    <ImageButton
        android:id="@+id/promptInputVoiceBtn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="@dimen/pk_space_2"
        android:src="@drawable/ic_mic"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/prompt_input_voice_tooltip"
        android:scaleType="centerInside"
        android:padding="@dimen/pk_space_2" />

    <!-- Send action: arrow icon with tooltip -->
    <ImageButton
        android:id="@+id/promptInputSendBtn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_send"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/prompt_input_send_tooltip"
        android:scaleType="centerInside"
        android:padding="@dimen/pk_space_2" />

</merge>