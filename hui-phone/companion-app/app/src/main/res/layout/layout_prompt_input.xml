<?xml version="1.0" encoding="utf-8"?>
<!-- PromptInputLayout: rounded-3xl border p-2 shadow-xs bg-background border-input -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/pk_space_2"
        android:paddingBottom="@dimen/pk_space_2">

        <!-- Attachment previews: above the textarea (FileUpload previews),
             NOT in the actions row. Populated by AttachmentPicker. -->
        <LinearLayout
            android:id="@+id/promptInputPreviews"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="@dimen/pk_space_1"
            android:visibility="gone" />

        <!-- Textarea: text-base (16sp) like prompt-kit; placeholder is the
             SAME size (web placeholder inherits input font size). sp units
             so text scales with the user's font-size setting. -->
        <FrameLayout
            android:id="@+id/promptInputTextareaWrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.hui.companion.ui.AutoSizingEditText
                android:id="@+id/promptInputTextarea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/pk_input_min_height"
                android:textSize="@dimen/pk_text_base"
                android:textColor="@color/pk_foreground"
                android:background="@null"
                android:padding="@dimen/pk_space_2"
                android:gravity="center"
                android:inputType="textMultiLine|textCapSentences"
                android:imeOptions="actionSend"
                android:maxLines="10"
                android:singleLine="false"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/promptInputPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/prompt_input_placeholder"
                android:textSize="@dimen/pk_text_base"
                android:textColor="@color/pk_muted_foreground"
                android:alpha="0.8"
                android:gravity="center"
                android:padding="@dimen/pk_space_2"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no" />

        </FrameLayout>

        <!-- Actions: flex items-center gap-2 -->
        <com.hui.companion.ui.PromptInputActions
            android:id="@+id/promptInputActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/pk_space_2" />

    </LinearLayout>
</merge>
