<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pk_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pk_primary">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:titleTextColor="@color/pk_primary_foreground"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationContentDescription="@string/back" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:padding="@dimen/pk_space_4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/pk_space_8">

            <!-- Authentication card (top) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_settings_card"
                android:padding="@dimen/pk_space_6"
                android:layout_marginBottom="@dimen/pk_space_4">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Authentication"
                    android:textSize="@dimen/pk_text_lg"
                    android:textStyle="bold"
                    android:textColor="@color/pk_card_foreground" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Scan a QR code from your Hermes terminal to (re)connect."
                    android:textSize="@dimen/pk_text_sm"
                    android:textColor="@color/pk_muted_foreground"
                    android:layout_marginTop="@dimen/pk_space_1" />

                <Button
                    android:id="@+id/authScanButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Scan QR code"
                    android:textSize="@dimen/pk_text_sm"
                    android:textColor="@color/pk_primary_foreground"
                    android:background="@drawable/bg_auth_button"
                    android:paddingStart="@dimen/pk_space_4"
                    android:paddingEnd="@dimen/pk_space_4"
                    android:layout_marginTop="@dimen/pk_space_4" />

                <TextView
                    android:id="@+id/authStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Status: Not authenticated"
                    android:textSize="@dimen/pk_text_xs"
                    android:textColor="@color/pk_muted_foreground"
                    android:layout_marginTop="@dimen/pk_space_2" />

                <EditText
                    android:id="@+id/manualPayloadInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="No camera? Paste the QR payload JSON here"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:textSize="@dimen/pk_text_xs"
                    android:layout_marginTop="@dimen/pk_space_3" />

                <Button
                    android:id="@+id/manualApplyButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Apply pasted payload"
                    android:textSize="@dimen/pk_text_sm"
                    android:textColor="@color/pk_primary_foreground"
                    android:background="@drawable/bg_auth_button"
                    android:paddingStart="@dimen/pk_space_4"
                    android:paddingEnd="@dimen/pk_space_4"
                    android:layout_marginTop="@dimen/pk_space_2" />

                <Button
                    android:id="@+id/authSignOutButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Unauthenticate"
                    android:textSize="@dimen/pk_text_sm"
                    android:textColor="@color/pk_primary_foreground"
                    android:background="@drawable/bg_auth_button"
                    android:paddingStart="@dimen/pk_space_4"
                    android:paddingEnd="@dimen/pk_space_4"
                    android:layout_marginTop="@dimen/pk_space_3"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- prompt-kit card: bg-card border rounded-lg shadow-xs p-6 space-y-4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_settings_card"
                android:padding="@dimen/pk_space_6">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Voice Settings"
                    android:textSize="@dimen/pk_text_lg"
                    android:textStyle="bold"
                    android:textColor="@color/pk_card_foreground" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Choose the voice used for spoken replies."
                    android:textSize="@dimen/pk_text_sm"
                    android:textColor="@color/pk_muted_foreground"
                    android:layout_marginTop="@dimen/pk_space_1" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Voice"
                    android:textSize="@dimen/pk_text_sm"
                    android:textColor="@color/pk_card_foreground"
                    android:layout_marginTop="@dimen/pk_space_4" />

                <!-- prompt-kit select trigger: h-9 rounded-md border px-3 text-sm -->
                <Spinner
                    android:id="@+id/voiceSpinner"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_settings_dropdown"
                    android:minWidth="180dp"
                    android:maxWidth="280dp"
                    android:paddingStart="@dimen/pk_space_3"
                    android:paddingEnd="@dimen/pk_space_3"
                    android:layout_marginTop="@dimen/pk_space_2"
                    android:spinnerMode="dropdown"
                    android:popupBackground="@drawable/bg_settings_dropdown_popup" />

                <TextView
                    android:id="@+id/voiceStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Current voice: system default"
                    android:textSize="@dimen/pk_text_xs"
                    android:textColor="@color/pk_muted_foreground"
                    android:layout_marginTop="@dimen/pk_space_2" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Changes apply immediately."
                    android:textSize="@dimen/pk_text_xs"
                    android:textColor="@color/pk_muted_foreground"
                    android:layout_marginTop="@dimen/pk_space_1" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
