<?xml version="1.0" encoding="utf-8"?>
<!-- item_chat_message: single chat bubble row (prompt-kit Message) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/bubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:maxWidth="300dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <!-- Message content: rendered blocks (text/markdown/image) via
             MarkdownRenderer, NOT a raw TextView. A plain TextView here
             showed ![alt](url) as literal text for attached images. -->
        <LinearLayout
            android:id="@+id/messageContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/timestampText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="12:00"
            android:textSize="@dimen/pk_text_xs"
            android:textColor="@color/timestamp_assistant" />

    </LinearLayout>

</FrameLayout>
