<?xml version="1.0" encoding="utf-8"?>
<!-- Upstream ThinkingBar stop: border-b border-dotted (bottom only).
     Android shape strokes all sides, so layer-list with 1dp line at bottom.
     border-muted-foreground/50 = muted-foreground at 50% alpha approx. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="bottom" android:height="1dp">
        <shape>
            <stroke
                android:width="1dp"
                android:color="#80A1A1AA"
                android:dashWidth="4dp"
                android:dashGap="4dp" />
        </shape>
    </item>
</layer-list>
